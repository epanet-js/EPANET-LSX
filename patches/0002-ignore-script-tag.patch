+static int startsnewsection(Parser *parser, int sect)
+/*
+**--------------------------------------------------------------
+**  Input:   parser = the input parser
+**           sect   = current input section
+**  Output:  returns TRUE if the current line begins a new section
+**  Purpose: decides whether a line starting with '[' opens a new
+**           section. Inside a [SCRIPT] section a line may be Lua
+**           code that starts with '[', so a new section is only
+**           recognized when the whole line is a single token that
+**           matches a known section name.
+**--------------------------------------------------------------
+*/
+{
+    if (parser->Tok[0][0] != '[') return FALSE;
+    if (sect != _SCRIPT) return TRUE;
+
+    return (parser->Ntokens == 1 && findmatch(parser->Tok[0], SectTxt) >= 0);
+}
