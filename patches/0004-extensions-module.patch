diff --git a/include/enext_toolkit.def b/include/enext_toolkit.def
new file mode 100644
index 0000000..1677079
--- /dev/null
+++ b/include/enext_toolkit.def
@@ -0,0 +1,19 @@
+/* enext_toolkit.def — the EPANET toolkit surface exposed to extensions.
+ *
+ * Each list item contains a EN_* function. The preprocessor expands the
+ * list three ways (host-table members in enext.h, the engine-side assignment
+ * in extensions.c, and the plugin-side shim forwarders in enext-shim.c).
+ * Adding a function is a single new line below.
+ *
+ * This file is included with X defined; it intentionally has no include guard.
+ *
+ *   X(return_type, member_name, (parameter list), (argument names))
+ *
+ * member_name is the EPANET function without its EN_ prefix (EN_##member_name).
+ * EN_getprivatedata / EN_setprivatedata are deliberately absent.
+ */
+
+X(int, getcount,     (EN_Project ph, int object, int *out_count),                 (ph, object, out_count))
+X(int, getnodeindex, (EN_Project ph, const char *id, int *out_index),             (ph, id, out_index))
+X(int, getnodevalue, (EN_Project ph, int index, int property, double *out_value), (ph, index, property, out_value))
+X(int, getlinktype,  (EN_Project ph, int index, int *out_linkType),               (ph, index, out_linkType))
diff --git a/src/extensions.c b/src/extensions.c
new file mode 100644
index 0000000..932c52f
--- /dev/null
+++ b/src/extensions.c
@@ -0,0 +1,437 @@
+/*
+******************************************************************************
+Project:      OWA EPANET
+Module:       extensions.c
+Description:  cross-platform loader and per-project dispatcher for sidecar
+              EPANET extensions (the ENEXT_ ABI, see include/enext.h)
+
+The engine looks in its own directory (or ENEXT_PLUGIN_PATH) for shared
+libraries, keeps the ones that export ENEXT_abi_version() with a matching
+version, injects a host-service + toolkit function table into each, and drives
+their optional lifecycle callbacks. Extensions are loaded once for the process
+(a write-once registry, read-only afterwards); every project owns its own array
+of per-extension private-data slots, so concurrent projects never collide.
+******************************************************************************
+*/
+
+#if !defined(_WIN32) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE   /* dladdr */
+#endif
+
+#if defined(_WIN32)
+  #include <windows.h>
+#else
+  #include <dlfcn.h>
+  #include <dirent.h>
+  #include <pthread.h>
+#endif
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "types.h"
+#include "enext.h"
+#include "extensions.h"
+
+#define EXT_PATH_MAX 4096
+
+/* ------------------------------------------------------------------------- */
+/* os_dynlib: the only platform-specific code in the module.                 */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+    void *handle;
+} os_lib;
+
+typedef void (*os_dir_cb)(const char *full_path, void *ctx);
+
+#if defined(_WIN32)
+
+typedef INIT_ONCE os_once;
+#define OS_ONCE_INIT INIT_ONCE_STATIC_INIT
+
+static int os_lib_open(const char *path, os_lib *out)
+{
+    WCHAR wide[EXT_PATH_MAX];
+    if (MultiByteToWideChar(CP_UTF8, 0, path, -1, wide, EXT_PATH_MAX) == 0) return 0;
+    HMODULE h = LoadLibraryW(wide);
+    if (h == NULL) return 0;
+    out->handle = (void *)h;
+    return 1;
+}
+
+static void *os_lib_sym(os_lib lib, const char *name)
+{
+    return (void *)GetProcAddress((HMODULE)lib.handle, name);
+}
+
+static void os_lib_close(os_lib lib)
+{
+    if (lib.handle != NULL) FreeLibrary((HMODULE)lib.handle);
+}
+
+static const char *os_lib_suffix(void) { return ".dll"; }
+
+static int os_self_dir(char *buf, size_t n)
+{
+    HMODULE self = NULL;
+    WCHAR wide[EXT_PATH_MAX];
+    DWORD len;
+    int i;
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                           GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCWSTR)(void *)os_self_dir, &self) == 0)
+        return 0;
+    len = GetModuleFileNameW(self, wide, EXT_PATH_MAX);
+    if (len == 0 || len >= EXT_PATH_MAX) return 0;
+    for (i = (int)len - 1; i >= 0; i--) {
+        if (wide[i] == L'\\' || wide[i] == L'/') { wide[i] = L'\0'; break; }
+    }
+    if (WideCharToMultiByte(CP_UTF8, 0, wide, -1, buf, (int)n, NULL, NULL) == 0) return 0;
+    return 1;
+}
+
+static int os_dir_each_lib(const char *dir, os_dir_cb cb, void *ctx)
+{
+    WCHAR pattern[EXT_PATH_MAX];
+    char utf8[EXT_PATH_MAX];
+    char full[EXT_PATH_MAX];
+    WIN32_FIND_DATAW find;
+    HANDLE h;
+    if (_snprintf(utf8, sizeof(utf8), "%s\\*.dll", dir) < 0) return 0;
+    if (MultiByteToWideChar(CP_UTF8, 0, utf8, -1, pattern, EXT_PATH_MAX) == 0) return 0;
+    h = FindFirstFileW(pattern, &find);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    do {
+        if (find.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        char name[EXT_PATH_MAX];
+        if (WideCharToMultiByte(CP_UTF8, 0, find.cFileName, -1, name, sizeof(name),
+                                NULL, NULL) == 0) continue;
+        if (_snprintf(full, sizeof(full), "%s\\%s", dir, name) < 0) continue;
+        cb(full, ctx);
+    } while (FindNextFileW(h, &find) != 0);
+    FindClose(h);
+    return 1;
+}
+
+static BOOL CALLBACK os_once_adapter(PINIT_ONCE once, PVOID param, PVOID *ctx)
+{
+    (void)once;
+    (void)ctx;
+    ((void (*)(void))param)();
+    return TRUE;
+}
+
+static void os_call_once(os_once *once, void (*fn)(void))
+{
+    InitOnceExecuteOnce(once, os_once_adapter, (PVOID)fn, NULL);
+}
+
+#else  /* POSIX */
+
+typedef pthread_once_t os_once;
+#define OS_ONCE_INIT PTHREAD_ONCE_INIT
+
+static int os_lib_open(const char *path, os_lib *out)
+{
+    void *h = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    if (h == NULL) return 0;
+    out->handle = h;
+    return 1;
+}
+
+static void *os_lib_sym(os_lib lib, const char *name)
+{
+    return dlsym(lib.handle, name);
+}
+
+static void os_lib_close(os_lib lib)
+{
+    if (lib.handle != NULL) dlclose(lib.handle);
+}
+
+static const char *os_lib_suffix(void)
+{
+#if defined(__APPLE__)
+    return ".dylib";
+#else
+    return ".so";
+#endif
+}
+
+static int os_self_dir(char *buf, size_t n)
+{
+    Dl_info info;
+    const char *slash;
+    size_t len;
+    if (dladdr((void *)(uintptr_t)os_self_dir, &info) == 0 || info.dli_fname == NULL)
+        return 0;
+    slash = strrchr(info.dli_fname, '/');
+    if (slash == NULL) {
+        if (n < 2) return 0;
+        buf[0] = '.';
+        buf[1] = '\0';
+        return 1;
+    }
+    len = (size_t)(slash - info.dli_fname);
+    if (len + 1 > n) return 0;
+    memcpy(buf, info.dli_fname, len);
+    buf[len] = '\0';
+    return 1;
+}
+
+static int os_dir_each_lib(const char *dir, os_dir_cb cb, void *ctx)
+{
+    DIR *d = opendir(dir);
+    const char *suffix = os_lib_suffix();
+    size_t suffix_len = strlen(suffix);
+    struct dirent *entry;
+    char full[EXT_PATH_MAX];
+    if (d == NULL) return 0;
+    while ((entry = readdir(d)) != NULL) {
+        size_t name_len = strlen(entry->d_name);
+        if (name_len <= suffix_len) continue;
+        if (strcmp(entry->d_name + name_len - suffix_len, suffix) != 0) continue;
+        if (snprintf(full, sizeof(full), "%s/%s", dir, entry->d_name) >= (int)sizeof(full))
+            continue;
+        cb(full, ctx);
+    }
+    closedir(d);
+    return 1;
+}
+
+static void os_call_once(os_once *once, void (*fn)(void))
+{
+    pthread_once(once, fn);
+}
+
+#endif
+
+/* ------------------------------------------------------------------------- */
+/* Registry, host table and per-project slots.                               */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+    os_lib lib;
+    int (ENEXT_CALL *cb_open)(EN_Project, const char *);
+    int (ENEXT_CALL *cb_init)(EN_Project);
+    int (ENEXT_CALL *cb_run)(EN_Project);
+    int (ENEXT_CALL *cb_next)(EN_Project);
+    int (ENEXT_CALL *cb_close)(EN_Project);
+    size_t index;
+} extension;
+
+/* Write-once registry, built by loadExtensionsOnce() under os_call_once and
+** read-only afterwards. The host table is likewise immutable after init. These
+** are the module's only globals; all per-run mutable state lives on the
+** project (Project.ext_slots), keyed by extension->index. */
+static extension     *loadedExtensions = NULL;
+static size_t         loadedCount = 0;
+static ENEXT_HostApi  hostTable;
+static os_once        loadOnce = OS_ONCE_INIT;
+
+static int latch(int errcode, int next)
+{
+    return (errcode > 100) ? errcode : next;
+}
+
+/* Host services: `self` is the extension record, so storage is keyed by
+** (project, extension) with no collision between extensions. */
+static void *ENEXT_CALL host_getprivatedata(ENEXT_Handle self, EN_Project ph)
+{
+    extension *ext = (extension *)self;
+    Project *pr = (Project *)ph;
+    if (ext == NULL || pr == NULL || pr->ext_slots == NULL) return NULL;
+    return pr->ext_slots[ext->index];
+}
+
+static int ENEXT_CALL host_setprivatedata(ENEXT_Handle self, EN_Project ph, void *data)
+{
+    extension *ext = (extension *)self;
+    Project *pr = (Project *)ph;
+    if (ext == NULL) return 102;
+    if (pr == NULL || pr->ext_slots == NULL) return 102;
+    pr->ext_slots[ext->index] = data;
+    return 0;
+}
+
+static void buildHostTable(ENEXT_HostApi *t)
+{
+    memset(t, 0, sizeof(*t));
+    t->api_version = ENEXT_ABI_VERSION;
+    t->struct_size = (unsigned int)sizeof(ENEXT_HostApi);
+    t->getprivatedata = host_getprivatedata;
+    t->setprivatedata = host_setprivatedata;
+    #define X(ret, name, params, args) t->name = EN_##name;
+    #include "enext_toolkit.def"
+    #undef X
+}
+
+typedef struct {
+    extension *items;
+    size_t count;
+    size_t capacity;
+} discovery;
+
+static void tryLoadCandidate(const char *path, void *ctx)
+{
+    discovery *disc = (discovery *)ctx;
+    os_lib lib;
+    int (ENEXT_CALL *abi)(void);
+    int (ENEXT_CALL *load)(ENEXT_Handle, const ENEXT_HostApi *);
+    extension *ext;
+
+    if (!os_lib_open(path, &lib)) return;
+
+    abi = (int (ENEXT_CALL *)(void))(uintptr_t)os_lib_sym(lib, ENEXT_SYM_ABI_VERSION);
+    if (abi == NULL || abi() != (int)ENEXT_ABI_VERSION) {
+        os_lib_close(lib);
+        return;
+    }
+    load = (int (ENEXT_CALL *)(ENEXT_Handle, const ENEXT_HostApi *))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_LOAD);
+    if (load == NULL) {
+        os_lib_close(lib);
+        return;
+    }
+
+    if (disc->count == disc->capacity) {
+        size_t cap = disc->capacity ? disc->capacity * 2 : 4;
+        extension *grown = (extension *)realloc(disc->items, cap * sizeof(extension));
+        if (grown == NULL) {
+            os_lib_close(lib);
+            return;
+        }
+        disc->items = grown;
+        disc->capacity = cap;
+    }
+
+    ext = &disc->items[disc->count];
+    memset(ext, 0, sizeof(*ext));
+    ext->lib = lib;
+    ext->index = disc->count;
+    ext->cb_open  = (int (ENEXT_CALL *)(EN_Project, const char *))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_OPEN);
+    ext->cb_init  = (int (ENEXT_CALL *)(EN_Project))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_INIT);
+    ext->cb_run   = (int (ENEXT_CALL *)(EN_Project))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_RUN);
+    ext->cb_next  = (int (ENEXT_CALL *)(EN_Project))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_NEXT);
+    ext->cb_close = (int (ENEXT_CALL *)(EN_Project))(uintptr_t)
+        os_lib_sym(lib, ENEXT_SYM_CLOSE);
+
+    if (load(ext, &hostTable) != 0) {
+        os_lib_close(lib);
+        return;
+    }
+    disc->count++;
+}
+
+static void loadExtensionsOnce(void)
+{
+    char dir[EXT_PATH_MAX];
+    const char *env;
+    discovery disc;
+
+    buildHostTable(&hostTable);
+
+    env = getenv("ENEXT_PLUGIN_PATH");
+    if (env != NULL && env[0] != '\0') {
+        size_t len = strlen(env);
+        if (len >= sizeof(dir)) return;
+        memcpy(dir, env, len + 1);
+    } else if (!os_self_dir(dir, sizeof(dir))) {
+        return;
+    }
+
+    disc.items = NULL;
+    disc.count = 0;
+    disc.capacity = 0;
+    os_dir_each_lib(dir, tryLoadCandidate, &disc);
+
+    loadedExtensions = disc.items;
+    loadedCount = disc.count;
+}
+
+static int ensureReady(Project *pr)
+{
+    os_call_once(&loadOnce, loadExtensionsOnce);
+    if (pr == NULL) return 0;
+    if (pr->ext_slots == NULL && loadedCount > 0) {
+        pr->ext_slots = (void **)calloc(loadedCount, sizeof(void *));
+        if (pr->ext_slots == NULL) return 101;
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Dispatch entry points (called from the toolkit).                          */
+/* ------------------------------------------------------------------------- */
+
+int extensions_open(EN_Project pr, const char *inpFile)
+{
+    int errcode = ensureReady((Project *)pr);
+    size_t i;
+    for (i = 0; i < loadedCount; i++) {
+        if (loadedExtensions[i].cb_open != NULL)
+            errcode = latch(errcode, loadedExtensions[i].cb_open(pr, inpFile));
+    }
+    return errcode;
+}
+
+int extensions_init(EN_Project pr)
+{
+    int errcode = ensureReady((Project *)pr);
+    size_t i;
+    for (i = 0; i < loadedCount; i++) {
+        if (loadedExtensions[i].cb_init != NULL)
+            errcode = latch(errcode, loadedExtensions[i].cb_init(pr));
+    }
+    return errcode;
+}
+
+int extensions_run(EN_Project pr)
+{
+    int errcode = ensureReady((Project *)pr);
+    size_t i;
+    for (i = 0; i < loadedCount; i++) {
+        if (loadedExtensions[i].cb_run != NULL)
+            errcode = latch(errcode, loadedExtensions[i].cb_run(pr));
+    }
+    return errcode;
+}
+
+int extensions_next(EN_Project pr)
+{
+    int errcode = ensureReady((Project *)pr);
+    size_t i;
+    for (i = 0; i < loadedCount; i++) {
+        if (loadedExtensions[i].cb_next != NULL)
+            errcode = latch(errcode, loadedExtensions[i].cb_next(pr));
+    }
+    return errcode;
+}
+
+int extensions_close(EN_Project pr)
+{
+    int errcode = 0;
+    size_t i;
+    for (i = 0; i < loadedCount; i++) {
+        if (loadedExtensions[i].cb_close != NULL)
+            errcode = latch(errcode, loadedExtensions[i].cb_close(pr));
+    }
+    return errcode;
+}
+
+void extensions_free(EN_Project pr)
+{
+    Project *p = (Project *)pr;
+    if (p == NULL || p->ext_slots == NULL) return;
+    extensions_close(pr);
+    free(p->ext_slots);
+    p->ext_slots = NULL;
+}
diff --git a/src/extensions.h b/src/extensions.h
new file mode 100644
index 0000000..ace92b3
--- /dev/null
+++ b/src/extensions.h
@@ -0,0 +1,32 @@
+/*
+******************************************************************************
+Project:      OWA EPANET
+Module:       extensions.h
+Description:  discovery, loading and per-project dispatch of dynamically-loaded
+              EPANET extensions (sidecar shared libraries implementing the
+              ENEXT_ ABI, see include/enext.h)
+******************************************************************************
+*/
+#ifndef EXTENSIONS_H
+#define EXTENSIONS_H
+
+#include "epanet2_2.h"   /* EN_Project */
+
+/* On first use these discover and load the extension libraries once for the
+** process, then allocate this project's per-extension data slots and dispatch
+** the matching optional callback to every loaded extension. Each returns a
+** latched EPANET error code (0 on success, worst fatal >100 preserved) and is
+** safe to call with a NULL project. */
+int extensions_open(EN_Project pr, const char *inpFile);   /* dispatch ENEXT_open  */
+int extensions_init(EN_Project pr);                        /* dispatch ENEXT_init  */
+int extensions_run(EN_Project pr);                         /* dispatch ENEXT_run   */
+int extensions_next(EN_Project pr);                        /* dispatch ENEXT_next  */
+int extensions_close(EN_Project pr);                       /* dispatch ENEXT_close */
+
+/* Releases this project's per-extension slots. Dispatches ENEXT_close first (so
+** extensions can tear down per-project state even when EN_closeH was not
+** called); ENEXT_close must therefore tolerate being invoked more than once.
+** Accepts NULL and is safe to call repeatedly. */
+void extensions_free(EN_Project pr);
+
+#endif
diff --git a/src/types.h b/src/types.h
index 468748a..dd1eb79 100755
--- a/src/types.h
+++ b/src/types.h
@@ -921,6 +921,8 @@ typedef struct Project {
     TmpOutFname[MAXFNAME+1],     // Temporary output file name
     TmpStatFname[MAXFNAME+1];    // Temporary statistic file name
 
+  void **ext_slots;              // Per-extension private-data slots (owned by extensions.c)
+
   void (* viewprog) (char *);    // Pointer to progress viewing function
 
   void *private_data;            // Opaque per-project data for host extensions
