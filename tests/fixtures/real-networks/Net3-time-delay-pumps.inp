[SCRIPT]
-- Time-delayed standby pump on Net3, fully script-driven.
-- Duty pump 335 runs a level band on tank 1: on below DUTY_ON, off
-- above DUTY_OFF. Standby PU1 starts only after the tank has kept
-- falling for STANDBY_DELAY with the duty pump running, then rides
-- with the duty pump until the tank reaches DUTY_OFF, where both
-- stop together.
--
-- Levels and timing are set in the block at the top of on_open.
-- The asset ids ("335", "PU1", "1") are hard-coded at each
-- node()/link() call: passing them through variables is not yet
-- supported. Once that is fixed they can become settings too.

function on_open()
    -- ==== user settings =============================================
    DUTY_ON       = 12.0    -- duty starts below this tank level
    DUTY_OFF      = 16.0    -- both pumps stop above this tank level
    STANDBY_DELAY = 1800    -- seconds of continuous drawdown, with
                            -- the duty pump running, before the
                            -- standby is called on
    -- ================================================================

    prev_level  = nil
    falling_for = 0
    last_time   = nil
    duty_on     = link("335").status == 1
    standby_on  = false
    print(string.format(
        "Station logic armed: duty 335 on band %.1f/%.1f,",
        DUTY_ON, DUTY_OFF))
    print(string.format(
        "standby PU1 after %d min of drawdown, both stop at %.1f",
        math.floor(STANDBY_DELAY / 60), DUTY_OFF))
end

function on_hydraulic_step()
    local tank  = node("1")
    local level = tank.head - tank.elevation

    -- Duty pump: plain level band with hysteresis
    if not duty_on and level < DUTY_ON then
        link("335").status = 1
        duty_on = true
        print(string.format(">>> duty 335 started (tank 1 at %.2f)", level))
    elseif duty_on and level > DUTY_OFF then
        link("335").status = 0
        duty_on = false
        print(string.format(">>> duty 335 stopped (tank 1 at %.2f)", level))
    end

    -- Standby pump: delayed start, stops when the duty pump stops
    if not standby_on and falling_for >= STANDBY_DELAY then
        link("PU1").status = 1
        standby_on = true
        print(string.format(
            ">>> standby PU1 STARTED: tank 1 at %.2f after %d min of drawdown",
            level, math.floor(falling_for / 60)))
    elseif standby_on and not duty_on then
        link("PU1").status = 0
        standby_on  = false
        falling_for = 0
        print(string.format(
            ">>> standby PU1 stopped with duty (tank 1 at %.2f)", level))
    end
end

function on_hydraulics_solved()
    local tank  = node("1")
    local level = tank.head - tank.elevation
    local t     = times().hydraulic_time

    -- Steps can be shortened by tank/control events, so measure the
    -- window from actual elapsed time, not the nominal step length.
    local dt = last_time and (t - last_time) or 0
    last_time = t

    if prev_level ~= nil and duty_on and level < prev_level - 0.001 then
        falling_for = falling_for + dt
    else
        falling_for = 0
    end
    prev_level = level

    print(string.format(
        "%d:%02d  tank1 %.2f  duty %s  standby %s  falling %d min",
        math.floor(t / 3600), math.floor(t % 3600 / 60), level,
        duty_on and "ON " or "off",
        standby_on and "ON " or "off",
        math.floor(falling_for / 60)))
end

