[SCRIPT]
-- Float valve simulation
--
-- A float valve progressively closes as the tank level rises, throttling
-- inflow to prevent overflow. The valve is modelled as a TCV (Throttle
-- Control Valve) whose minor-loss coefficient K is adjusted at each
-- timestep based on the current tank water level.
--
-- The logic has three parts:
--
--   1. Compute how far open the valve is (0–100 %) from the tank level.
--      The valve is fully open when the level is below (controlDepth - range)
--      and fully closed when the level reaches controlDepth. In between it
--      scales linearly.
--
--   2. Map the open percentage to a K value using a 9-point curve. The
--      curve spans many orders of magnitude (K = 2 at 100 % open up to
--      K ~ 1e20 at 0 % open) so logarithmic interpolation is used between
--      points rather than linear interpolation.
--
--   3. Apply the K value to the TCV every iteration. Because the setting
--      is written inside on_event("iteration"), EPANET re-solves with the
--      updated K so it takes effect within the current timestep.

-- Float valve parameters
local controlDepth = 4.6   -- tank level (m) at which the valve is fully closed
local range        = 1.0   -- regulation range below controlDepth (m)
local multiplier   = 1     -- curve K multiplier

-- Valve characteristic curve: { open_percent, k_value }
-- K increases as the valve closes — very large K means almost no flow.
local curve = {
    {   0, 1e20   },
    {   2, 1e10   },
    {   4, 1e5    },
    {  10, 5012   },
    {  20, 1202   },
    {  40, 250    },
    {  60, 50     },
    {  80, 10     },
    { 100, 2      }
}

-- Returns how far open the valve is (0–100 %) based on the tank level.
-- Below (controlDepth - range) the valve is wide open; above controlDepth
-- it is fully closed.
local function get_open_percent(level)
    if level < controlDepth - range then
        return 100
    end
    if level > controlDepth then
        return 0
    end
    return ((controlDepth - level) / range) * 100
end

-- Looks up the K value for a given open percentage by walking the curve
-- and interpolating logarithmically between the two bracketing points.
-- Logarithmic interpolation is essential here because K spans ~18 orders
-- of magnitude — linear interpolation would produce wildly wrong values
-- in the steep parts of the curve.
local function get_k_value(open_pct)
    -- At or below the first curve point (fully closed)
    if open_pct <= curve[1][1] then
        return curve[1][2] * multiplier
    end
    -- At or above the last curve point (fully open)
    if open_pct >= curve[#curve][1] then
        return curve[#curve][2] * multiplier
    end
    -- Find the two curve points that bracket the open percentage
    for i = 2, #curve do
        if open_pct <= curve[i][1] then
            local lo_pct, lo_k = curve[i - 1][1], curve[i - 1][2]
            local hi_pct, hi_k = curve[i][1],     curve[i][2]
            local f = (open_pct - lo_pct) / (hi_pct - lo_pct)
            -- Logarithmic interpolation:  K = (K_hi * m)^f  *  (K_lo * m)^(1-f)
            return (hi_k * multiplier) ^ f * (lo_k * multiplier) ^ (1 - f)
        end
    end
    return curve[#curve][2] * multiplier
end

function on_hydraulic_step()
    -- For a tank node, pressure equals the water level above the
    -- tank's base elevation, which is exactly what we need.
    local level    = node("T1").pressure
    local open_pct = get_open_percent(level)
    local k        = get_k_value(open_pct)
    local tcv      = link("V1")

    -- Only update if the K value has changed meaningfully
    if math.abs(tcv.setting - k) > 0.01 then
        tcv.setting = k
        print(string.format(
            "  Float valve: level=%.3f m | open=%.1f%% | K=%.1f",
            level, open_pct, k))
    end
end

function on_hydraulics_solved()
    -- Summary line per timestep showing the settled state
    local level = node("T1").pressure
    local tcv   = link("V1")
    print(string.format(
        "  Step: level=%.3f m | open=%.1f%% | K=%.1f | inflow=%.3f LPS",
        level, get_open_percent(level), tcv.setting, tcv.flow))
end

