[SCRIPT]
-- Flow-modulating PRV example
--
-- Adjusts the PRV downstream pressure setpoint based on the current
-- flow rate through the valve. A lookup table defines the
-- flow-to-pressure relationship, with linear interpolation between
-- entries and clamping to the nearest boundary outside the table.
--
-- The table uses four points with different slopes to show that the
-- interpolation rate varies between segments:
--
--   Flow (LPS)   Pressure (m)   Slope
--   ----------   ------------   -----
--        3.0          20         --
--        6.0          25         1.67 m per LPS
--        8.0          29         2.0 m per LPS
--       10.0          32         1.5 m per LPS
--
-- Observed flow range through V1 is roughly 2.5 - 9.6 LPS over the
-- 24-hour demand cycle. The lower table bound (3.0) sits just inside
-- that range, so low-flow clamping shows overnight; the upper bound
-- (10.0) is above the observed peak, so the top segment interpolates
-- but never clamps.
--
-- The modulation runs in on_hydraulic_step: if it changes the
-- setting, the step is re-solved and the handler runs again, until
-- the setting matches the interpolated target and the write guard
-- stops making changes. on_hydraulics_solved prints one summary
-- line per settled step.

-- Lookup table: parallel arrays of flow and target pressure.
-- Globals rather than locals so the handlers can see them.
flows     = { 3.0,  6.0,  8.0,  10.0 }
pressures = { 20.0, 25.0, 29.0, 32.0 }

-- Linear interpolation with clamping at the table boundaries
function interpolate(q, qs, ps)
    if q <= qs[1]   then return ps[1]   end
    if q >= qs[#qs] then return ps[#qs] end
    for i = 1, #qs - 1 do
        if q <= qs[i + 1] then
            local frac = (q - qs[i]) / (qs[i + 1] - qs[i])
            return ps[i] + frac * (ps[i + 1] - ps[i])
        end
    end
    return ps[#ps]
end

function on_hydraulic_step()
    local v1     = link("V1")
    local flow   = v1.flow
    local target = interpolate(flow, flows, pressures)

    -- Only update if the setting differs meaningfully: once the
    -- setting matches the target, no write means no re-solve.
    if math.abs(v1.setting - target) > 0.01 then
        print(string.format(
            "  Modulating: flow=%.2f LPS -> target pressure=%.2f m (was %.2f m)",
            flow, target, v1.setting))
        v1.setting = target
    end
end

function on_hydraulics_solved()
    local v1   = link("V1")
    local j113 = node("J3")
    print(string.format(
        "  Step: V1 flow=%.2f LPS | PRV setting=%.2f m | J113 pressure=%.2f m",
        v1.flow, v1.setting, j113.pressure))
end

