[SCRIPT]
-- PCV acting as a PRV.
-- V1 modulates its % open (0-100) so junction J4 holds 20.00,
-- accepting anything within 1% (+/- 0.20) of the set point.
-- Note: the ids, set point and band are written inline below until
-- top-level variables are usable from handlers.

function on_open()
    -- Ignore whatever % open the input file starts the valve at:
    -- begin from mid-travel and let the first step find its own fit.
    link("V1").setting = 50.0
    lo = 0.0
    hi = 100.0
    print("PCV-as-PRV: V1 holding J4 at 20.00 (+/- 0.20)")
end

function on_hydraulic_step()
    local setting  = link("V1").setting
    local pressure = node("J4").pressure

    -- A near-closed PCV cuts the junction off and the solver reports
    -- a huge negative pressure. Treat that as "too closed", not data.
    local cut_off = pressure < -100.0

    if not cut_off and math.abs(pressure - 20.0) <= 0.2 then
        return                       -- within the band: hold position
    end
    if not cut_off and pressure < 20.0 and setting >= 99.99 then
        return                       -- fully open and still short
    end

    -- Bisection: pressure rises with % open, so each reading tightens
    -- one side of the bracket and the valve moves to the midpoint.
    if cut_off or pressure < 20.0 then
        if setting > lo then lo = setting end
    else
        if setting < hi then hi = setting end
    end

    local new_setting = (lo + hi) / 2.0
    if math.abs(new_setting - setting) > 0.01 then
        link("V1").setting = new_setting
    end
end

function on_hydraulics_solved()
    local t = times().hydraulic_time
    print(string.format("%d:%02d  V1 at %.1f%% open, J4 at %.2f",
          math.floor(t / 3600), math.floor(t % 3600 / 60),
          link("V1").setting, node("J4").pressure))
    lo = 0.0
    hi = 100.0
end

[END]
