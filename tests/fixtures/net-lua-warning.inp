[TITLE]
Lua script that raises a warning during the 1:00 hydraulic step

[JUNCTIONS]
 J1  100
 J2   90

[RESERVOIRS]
 R1  200

[PIPES]
 P1  R1  J1  1000  12  100  0  Open
 P2  J1  J2  1000  12  100  0  Open

[SCRIPT]
function on_hydraulic_step()
  if times().hydraulic_time == 3600 then
    warning("J1 elevation", node("J1").elevation)
    local j = node("J1")
    if j.elevation < 103 then
      j.elevation = j.elevation + 1
    end
  end
end

[TIMES]
 Duration         2:00
 Hydraulic Timestep  1:00

[COORDINATES]
 J1  0  0
 J2  1  0
 R1  0  1

[OPTIONS]
 Units  LPS

[END]
