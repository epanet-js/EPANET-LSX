[TITLE]
Small net with an embedded Lua script

[JUNCTIONS]
 J1  100
 J2   90

[RESERVOIRS]
 R1  200

[PIPES]
 P1  R1  J1  1000  12  100  0  Open
 P2  J1  J2  1000  12  100  0  Open

[SCRIPT]
-- Lua embedded in the INP file
local t = {}
t[1] = 42
if t[1] > 0 then
  print("value is " .. t[1])
end

[COORDINATES]
 J1  0  0
 J2  1  0
 R1  0  1

[OPTIONS]
 Units  LPS

[END]
